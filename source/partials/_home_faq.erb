<section id="faq" class="border-t border-base-content/10 bg-base-200/50" aria-labelledby="faq-title">
  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 lg:grid-cols-12 lg:py-28">
    <div class="lg:col-span-4">
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-title" class="h2 mt-3">Häufige <span class="text-gradient">Fragen</span></h2>
      <p class="mt-5 text-base-content/80">Deine Frage ist nicht dabei? Ruf uns an: <a class="link link-primary whitespace-nowrap font-semibold" href="<%= tel_link data.site.contacts.first.tel %>"><%= phone(data.site.contacts.first.phone) %></a></p>
    </div>
    <div class="space-y-3 lg:col-span-8">
      <% data.faq.each do |f| %>
        <details class="group tile">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 text-lg font-semibold tracking-tight sm:p-6">
            <h3><%= f.frage %></h3>
            <span class="grid size-8 shrink-0 place-items-center rounded-full border border-base-content/20 text-xl leading-none transition group-open:rotate-45 group-open:border-primary group-open:text-primary" aria-hidden="true">+</span>
          </summary>
          <p class="px-5 pb-6 text-base-content/85 sm:px-6"><%= f.antwort %></p>
        </details>
      <% end %>
    </div>
  </div>
</section>
