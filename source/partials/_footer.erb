<div class="groove" aria-hidden="true"></div>
<footer class="bg-base-200/60">
  <div class="mx-auto max-w-7xl px-4 pb-8 pt-12 sm:pt-16">
    <p class="display select-none text-base-content/90" style="font-size:clamp(2.25rem,5vw,4rem)" aria-hidden="true">Total <span class="text-gradient">Guth<span>!</span></span></p>

    <div class="mt-10 grid sm:mt-14 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <h2 class="eyebrow">Fahrschule Guth</h2>
        <address class="mt-4 not-italic leading-relaxed text-base-content/80">
          Hattinger Str. 136<br>44795 Bochum-Weitmar
        </address>
        <a class="link link-hover mt-3 inline-flex items-center gap-2 text-sm" href="https://www.openstreetmap.org/?mlat=<%= data.site.geo.lat %>&amp;mlon=<%= data.site.geo.lon %>#map=18/<%= data.site.geo.lat %>/<%= data.site.geo.lon %>" target="_blank" rel="noopener noreferrer"><%= icon :pin, css: "size-4 text-primary" %> Route ansehen</a>
      </div>

      <nav aria-label="Seiten">
        <h2 class="eyebrow">Seiten</h2>
        <ul class="mt-4 space-y-2">
          <% data.site.footer_nav.each do |l| %><li><a class="link link-hover" href="<%= l.href %>"><%= l.label %></a></li><% end %>
        </ul>
      </nav>

      <nav aria-label="Nützliche Links">
        <h2 class="eyebrow">Nützliche Links</h2>
        <ul class="mt-4 space-y-2">
          <% data.links.links.each do |l| %>
            <li><a class="link link-hover" href="<%= l.url %>" target="_blank" rel="noopener noreferrer"><%= l.name %></a></li>
          <% end %>
        </ul>
      </nav>

      <div>
        <h2 class="eyebrow">Kontakt</h2>
        <ul class="mt-4 space-y-3">
          <% data.site.contacts.each do |c| %>
            <li>
              <p class="text-sm text-base-content/70"><%= c.name %> · <%= c.role %></p>
              <a class="link link-hover" href="<%= tel_link c.tel %>"><%= phone(c.phone) %></a><br>
              <a class="link link-hover break-all text-sm" href="mailto:<%= c.email %>"><%= c.email %></a>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-base-content/10 pt-6 text-sm text-base-content/70 sm:flex-row sm:items-center">
      <p>© <%= Time.now.year %> Fahrschule Ulrich Guth · Made with ❤️ in Bochum</p>
      <ul class="flex items-center gap-5">
        <% data.site.legal_nav.each do |l| %><li><a class="link link-hover" href="<%= l.href %>"><%= l.label %></a></li><% end %>
        <li><a href="<%= data.site.facebook %>" class="link link-hover" rel="noopener noreferrer" target="_blank" aria-label="Facebook"><%= social_icon :facebook %></a></li>
      </ul>
    </div>
  </div>
</footer>
