<footer class="bg-base-200 text-base-content">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="sm:col-span-2 lg:col-span-1">
      <a href="/" class="inline-flex items-center gap-2 text-xl font-bold">
        <span class="grid size-8 place-items-center rounded-lg bg-primary text-primary-content">G</span>
        Fahrschule Guth
      </a>
      <address class="mt-4 text-sm not-italic leading-relaxed text-base-content/70">
        <%= data.site.address.street %><br><%= data.site.address.plz %> <%= data.site.address.city %>
      </address>
      <p class="mt-3 text-sm text-base-content/70">Made with ❤️ in Bochum!</p>
      <ul class="mt-5 flex gap-3">
        <li><a href="<%= data.site.facebook %>" class="btn btn-circle btn-ghost btn-sm" rel="noopener noreferrer" target="_blank" aria-label="Facebook"><%= social_icon :facebook %></a></li>
      </ul>
    </div>
    <nav aria-label="Menü">
      <h2 class="footer-title">Links</h2>
      <ul class="space-y-2 text-sm">
        <% data.site.nav.reject { |n| n.href == "/" }.each do |l| %><li><a class="link link-hover" href="<%= l.href %>"><%= l.label %></a></li><% end %>
      </ul>
    </nav>
    <nav aria-label="Nützliche Links">
      <h2 class="footer-title">Nützliche Links</h2>
      <ul class="space-y-2 text-sm">
        <% [["Preiswahrheit", "http://www.preiswahrheit.de/"], ["TÜV Essen", "http://www.tuev-nord.de/essen-frillendorf/"], ["Testbögen", "http://www.fahrschule.de/testbogen/"], ["Unfallhilfe", "http://www.deutsche-unfallhilfe.de/"], ["Bußgeldkatalog", "http://www.bmvbs.de/"]].each do |name, url| %>
          <li><a class="link link-hover" href="<%= url %>" target="_blank" rel="noopener"><%= name %></a></li>
        <% end %>
      </ul>
    </nav>
    <div>
      <h2 class="footer-title">Fahrschule Guth</h2>
      <ul class="space-y-2 text-sm">
        <% data.site.contacts.each do |c| %>
          <li><a class="link link-hover inline-flex items-center gap-2" href="<%= tel_link c.tel %>"><%= icon :phone, css: "size-4 text-primary" %> <%= c.phone %></a></li>
          <li><a class="link link-hover inline-flex items-center gap-2 break-all" href="mailto:<%= c.email %>"><%= icon :mail, css: "size-4 text-primary" %> <%= c.email %></a></li>
        <% end %>
      </ul>
    </div>
  </div>
  <div class="border-t border-base-300">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-2 px-4 py-6 text-sm text-base-content/70 sm:flex-row">
      <p>© <%= Time.now.year %> Fahrschule Ulrich Guth</p>
      <p><a class="link link-hover" href="/impressum/">Impressum</a></p>
    </div>
  </div>
</footer>
