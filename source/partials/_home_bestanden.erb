<section id="bestanden" class="mx-auto max-w-7xl px-4 pb-8 sm:pb-12 lg:pb-16 xl:pb-20" aria-labelledby="bestanden-title">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div class="max-w-3xl">
      <p class="eyebrow">Geschafft</p>
      <h2 id="bestanden-title" class="h2 mt-3">Wir haben <span class="text-gradient">bestanden</span>!</h2>
      <p class="mt-4 text-lg text-base-content/80">100% Erfolg, 100% total Guth.</p>
    </div>
    <a href="/galerie/bestanden/" class="btn btn-outline rounded-full border-base-content/25">Mehr Fotos <%= icon :arrow, css: "size-5" %></a>
  </div>
  <% e = data.erfolg %>
  <% if e && (e.theorie_quote || e.praxis_quote || e.ausgebildet) %>
    <dl class="mt-8 grid gap-3 sm:grid-cols-3">
      <% if e.ausgebildet %><div class="tile p-5"><dt class="text-sm text-base-content/70">Erfolgreich ausgebildet<%= " (#{e.zeitraum})" if e.zeitraum %></dt><dd class="text-4xl font-bold tracking-tight text-primary"><%= e.ausgebildet %></dd></div><% end %>
      <% if e.theorie_quote %><div class="tile p-5"><dt class="text-sm text-base-content/70">Theorie bestanden<%= " (#{e.zeitraum})" if e.zeitraum %></dt><dd class="text-4xl font-bold tracking-tight text-primary"><%= e.theorie_quote %>&nbsp;%</dd></div><% end %>
      <% if e.praxis_quote %><div class="tile p-5"><dt class="text-sm text-base-content/70">Praxis bestanden<%= " (#{e.zeitraum})" if e.zeitraum %></dt><dd class="text-4xl font-bold tracking-tight text-primary"><%= e.praxis_quote %>&nbsp;%</dd></div><% end %>
    </dl>
    <p class="mt-3 text-sm text-base-content/70"><%= e.hinweis %></p>
  <% end %>
  <div class="mt-6 sm:mt-10">
    <%= gallery_grid data.galerie.bestanden.first(8), group: "bestanden-start" %>
  </div>
</section>
