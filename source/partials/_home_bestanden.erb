<section id="bestanden" class="mx-auto max-w-7xl px-4 pb-20 lg:pb-28" aria-labelledby="bestanden-title">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div class="max-w-3xl">
      <p class="eyebrow">Geschafft</p>
      <h2 id="bestanden-title" class="h2 mt-3">Wir haben <span class="text-gradient">bestanden</span>!</h2>
      <p class="mt-4 text-lg text-base-content/80">100% Erfolg, 100% total Guth.</p>
    </div>
    <a href="/galerie/bestanden/" class="btn btn-outline rounded-full border-base-content/25">Mehr Fotos <%= icon :arrow, css: "size-5" %></a>
  </div>
  <div class="mt-10">
    <%= gallery_grid data.galerie.bestanden.first(8), group: "bestanden-start" %>
  </div>
</section>
