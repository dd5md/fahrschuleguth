<%# Facebook-Seitenplugin: lädt erst nach Klick (keine Verbindung zu Facebook vorher). Funktioniert nur, wenn die Fahrschule eine öffentliche Facebook-SEITE hat. %>
<% fb = data.site.facebook %>
<section class="mx-auto max-w-7xl px-4 pb-10 sm:pb-16" aria-labelledby="fb-title">
  <div class="tile grid gap-6 p-6 sm:p-8 lg:grid-cols-12 lg:items-center">
    <div class="lg:col-span-6">
      <p class="eyebrow">Facebook</p>
      <h2 id="fb-title" class="h2 mt-3" style="font-size:clamp(1.9rem,4vw,3rem)">Neuigkeiten direkt von der <span class="text-gradient">Fahrschule</span></h2>
      <p class="mt-4 max-w-md text-base-content/80">Frische Fotos von bestandenen Prüfungen und Neues aus dem Alltag, so wie es auf unserer Facebook-Seite erscheint.</p>
      <a href="<%= fb %>" class="link link-primary mt-4 inline-flex items-center gap-2 font-semibold" target="_blank" rel="noopener noreferrer">Zur Facebook-Seite <%= icon :external, css: "size-4" %></a>
    </div>
    <div class="lg:col-span-6">
      <div class="tile min-h-[26rem]" data-title="Facebook-Seite der Fahrschule Guth"
           data-embed="https://www.facebook.com/plugins/page.php?href=<%= ERB::Util.url_encode(fb) %>&amp;tabs=timeline&amp;width=500&amp;height=620&amp;small_header=true&amp;adapt_container_width=true&amp;hide_cover=false&amp;show_facepile=false" data-height="620">
        <button type="button" class="flex size-full min-h-[26rem] flex-col items-center justify-center gap-3 p-6 text-center transition hover:bg-base-content/5">
          <span class="grid size-14 place-items-center rounded-full bg-primary text-primary-content"><%= social_icon :facebook, css: "size-7" %></span>
          <span class="font-semibold">Beiträge von Facebook laden</span>
          <span class="max-w-xs text-xs text-base-content/70">Beim Klick wird eine Verbindung zu Facebook (Meta) hergestellt und Daten wie deine IP-Adresse werden übertragen.</span>
        </button>
      </div>
    </div>
  </div>
</section>
