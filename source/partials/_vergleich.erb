<%# Motorradklassen im Vergleich (data/vergleich.yml). Auf schmalen Bildschirmen scrollt nur die Tabelle, nicht die Seite. %>
<section class="mt-12" aria-labelledby="vergleich-title">
  <p class="eyebrow">Motorradklassen</p>
  <h2 id="vergleich-title" class="h2 mt-3" style="font-size:clamp(1.8rem,4vw,3rem)">AM, A1, A2, A und B196 im Vergleich</h2>
  <p class="mt-3 max-w-3xl text-base-content/80">Welche Klasse passt zu dir? Die wichtigsten Unterschiede auf einen Blick.</p>
  <div class="tile mt-6 overflow-x-auto" tabindex="0" role="region" aria-label="Vergleichstabelle der Motorradklassen">
    <table class="w-full min-w-[46rem] border-collapse text-left text-sm">
      <thead>
        <tr>
          <th scope="col" class="p-4"><span class="sr-only">Merkmal</span></th>
          <% data.vergleich.spalten.each do |c| %>
            <th scope="col" class="p-4 text-base font-bold <%= c.hl ? 'bg-primary text-primary-content' : 'text-primary' %>"><a class="hover:underline" href="/fuehrerschein/<%= c.id %>/">Klasse <%= c.kurz %></a></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-base-content/10">
        <% data.vergleich.zeilen.each do |z| %>
          <tr>
            <th scope="row" class="whitespace-nowrap p-4 font-bold"><%= z.label %></th>
            <% z.werte.each_with_index do |w, i| %>
              <td class="p-4 align-top text-base-content/90 <%= 'bg-primary/10 font-semibold' if data.vergleich.spalten[i].hl %>"><%= w.to_s.empty? ? "–" : w %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <p class="mt-3 max-w-3xl text-sm text-base-content/70">Fahrzeugdaten nach dem Bundesverkehrsministerium. Planst du Touren im Ausland oder später größere Maschinen? Dann lohnt sich oft gleich A1, A2 oder A: Die B196-Schulung wird darauf nicht angerechnet und gilt nur in Deutschland.</p>
</section>
