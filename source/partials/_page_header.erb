<%# Seitenkopf für Unterseiten: große Überschrift links, optional Brotkrumen und Unternavigation (Frontmatter `subnav:`) %>
<% subnav = current_page.data.subnav %>
<section class="relative isolate overflow-hidden" aria-labelledby="page-title">
  <div class="hero-glow absolute inset-0 -z-10"></div>
  <div class="mx-auto max-w-7xl px-4 pb-8 pt-8 sm:pb-10 sm:pt-16">
    <% unless breadcrumbs.empty? %>
      <nav aria-label="Brotkrumen" class="mb-6 text-sm text-base-content/70">
        <ol class="flex flex-wrap items-center gap-2">
          <% breadcrumbs.each_with_index do |(name, url), i| %>
            <li class="flex items-center gap-2">
              <% if i == breadcrumbs.size - 1 %><span aria-current="page" class="text-base-content"><%= name %></span><% else %><a class="link link-hover" href="<%= url %>"><%= name %></a><span aria-hidden="true">/</span><% end %>
            </li>
          <% end %>
        </ol>
      </nav>
    <% end %>
    <% title = page_heading %>
    <%# Lange Titel (ab 20 Zeichen oder mit sehr langem Wort) kleiner setzen, damit sie in eine Zeile passen; letztes kurzes Wort bleibt am Wort davor %>
    <% long_title = title.length > 20 || title.split.map(&:length).max >= 16 %>
    <% size = long_title ? "clamp(1.45rem,6.4vw,4.4rem)" : "clamp(2.6rem,7.5vw,6rem)" %>
    <h1 id="page-title" class="display max-w-6xl" style="font-size:<%= size %>"><%= long_title ? ERB::Util.html_escape(title) : tidy(title) %></h1>
    <% lead = page_lead %>
    <p class="mt-5 max-w-2xl text-lg text-base-content/80 sm:text-xl"><%= lead %></p>
    <% if subnav %>
      <nav aria-label="Unterseiten" class="mt-8">
        <ul class="flex flex-wrap gap-2">
          <% data.site.subnav[subnav].each do |item| %>
            <% active = current_page.url == item.href %>
            <li><a href="<%= item.href %>" class="pill" <%= 'aria-current="page"' if active %>><%= item.label %></a></li>
          <% end %>
        </ul>
      </nav>
    <% end %>
  </div>
</section>
<div class="groove" aria-hidden="true"></div>
