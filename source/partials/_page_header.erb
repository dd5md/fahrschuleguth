<%# Locals: subnav (optional Schlüssel aus data.site.subnav) %>
<% subnav = locals[:subnav] || current_page.data.subnav %>
<section class="glow-bg">
  <div class="mx-auto max-w-5xl px-4 pb-6 pt-10 sm:pt-14">
    <% unless breadcrumbs.empty? %>
      <nav aria-label="Brotkrumen" class="mb-4 text-sm text-base-content/70">
        <ol class="flex flex-wrap items-center gap-2">
          <% breadcrumbs.each_with_index do |(name, url), i| %>
            <li class="flex items-center gap-2">
              <% if i == breadcrumbs.size - 1 %><span aria-current="page"><%= name %></span><% else %><a class="link link-hover" href="<%= url %>"><%= name %></a><span aria-hidden="true">/</span><% end %>
            </li>
          <% end %>
        </ol>
      </nav>
    <% end %>
    <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl"><%= current_page.data.pagetitle || current_page.data.title %></h1>
    <p class="mt-3 text-lg text-base-content/70"><%= current_page.data.smalltitle || data.site.subtitle %></p>
    <% if subnav %>
      <nav aria-label="Unterseiten" class="mt-6 flex flex-wrap gap-2">
        <% data.site.subnav[subnav].each do |item| %>
          <a href="<%= item.href %>" class="btn btn-sm rounded-full <%= current_page.url == item.href ? 'btn-primary' : 'btn-ghost border border-base-content/15' %>" <%= 'aria-current="page"' if current_page.url == item.href %>><%= item.label %></a>
        <% end %>
      </nav>
    <% end %>
  </div>
</section>
