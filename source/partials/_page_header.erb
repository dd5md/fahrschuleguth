<%# Zentrierter Seitenkopf im Stil der Demo. Optional: Frontmatter `subnav:` (Schlüssel aus data.site.subnav) %>
<% subnav = current_page.data.subnav %>
<section class="hero-bg relative overflow-hidden" aria-labelledby="page-title">
  <div class="mx-auto max-w-7xl px-4 pb-10 pt-12 text-center sm:pt-16">
    <% unless breadcrumbs.empty? %>
      <nav aria-label="Brotkrumen" class="mb-5 flex justify-center text-sm text-base-content/70">
        <ol class="flex flex-wrap items-center justify-center gap-2">
          <% breadcrumbs.each_with_index do |(name, url), i| %>
            <li class="flex items-center gap-2">
              <% if i == breadcrumbs.size - 1 %><span class="badge badge-primary badge-outline" aria-current="page"><%= name %></span><% else %><a class="link link-hover" href="<%= url %>"><%= name %></a><span aria-hidden="true">/</span><% end %>
            </li>
          <% end %>
        </ol>
      </nav>
    <% end %>
    <h1 id="page-title" class="mx-auto max-w-3xl text-4xl font-extrabold tracking-tight sm:text-6xl"><%= current_page.data.pagetitle || current_page.data.title %></h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-base-content/70"><%= current_page.data.smalltitle || data.site.subtitle %></p>
    <% if subnav %>
      <nav aria-label="Unterseiten" class="mt-8 flex justify-center">
        <div role="tablist" class="tabs tabs-box flex-wrap justify-center bg-base-200">
          <% data.site.subnav[subnav].each do |item| %>
            <% active = current_page.url == item.href %>
            <a role="tab" href="<%= item.href %>" class="tab <%= 'tab-active' if active %>" <%= 'aria-current="page"' if active %>><%= item.label %></a>
          <% end %>
        </div>
      </nav>
    <% end %>
  </div>
</section>
