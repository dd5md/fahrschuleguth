<section id="erster-fahrtag" class="border-y border-base-content/10 bg-base-200/50" aria-labelledby="ablauf-title">
  <div class="mx-auto grid max-w-7xl gap-14 px-4 py-20 lg:grid-cols-12 lg:py-28">
    <div class="lg:col-span-5">
      <p class="eyebrow">Keine Angst</p>
      <h2 id="ablauf-title" class="h2 mt-3">Dein erster <span class="text-gradient">Fahrtag</span></h2>
      <p class="mt-5 text-lg text-base-content/70"><%= data.ablauf.intro %></p>
      <p class="mt-8 flex items-center gap-3 rounded-2xl border border-primary/40 bg-primary/10 p-4 text-sm font-semibold">
        <%= icon :shield, css: "size-7 shrink-0 text-primary" %> Du bist immer gesichert: Dein Fahrlehrer hat eigene Pedale und kann jederzeit eingreifen.
      </p>
    </div>
    <ol class="space-y-4 lg:col-span-7">
      <% data.ablauf.schritte.each_with_index do |step, i| %>
        <li class="tile tile-hover flex gap-5 p-6 sm:p-7">
          <span class="text-5xl font-bold leading-none tracking-[-0.06em] text-primary/90"><%= i + 1 %></span>
          <div>
            <h3 class="h3"><%= step.titel %></h3>
            <p class="mt-2 text-base-content/70"><%= step.text %></p>
          </div>
        </li>
      <% end %>
    </ol>
  </div>
</section>
