<div class="groove" aria-hidden="true"></div>
<section id="klassen" class="mx-auto max-w-7xl px-4 py-8 sm:py-12 lg:py-16 xl:py-20" aria-labelledby="klassen-title">
  <div class="max-w-3xl">
    <p class="eyebrow">Führerscheinklassen</p>
    <h2 id="klassen-title" class="h2 mt-3">Welcher Führerschein passt zu <span class="text-gradient">dir</span>?</h2>
    <p class="mt-5 text-lg text-base-content/80">Auto, Moped, Motorrad, mit 17 oder ohne Prüfung: kurz erklärt. Alle Details findest du auf der Seite zu den Klassen.</p>
  </div>
  <ul class="mt-8 grid sm:mt-12 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <% data.klassen.select(&:home).each do |k| %>
      <li>
        <a href="/fuehrerschein/#<%= k.id %>" class="tile group flex h-full flex-col gap-4 p-6">
          <span class="text-5xl font-bold leading-none tracking-[-0.03em] text-primary"><%= k.kurz %></span>
          <div>
            <h3 class="h3-sm"><%= tidy k.titel %></h3>
            <p class="mt-2 text-sm text-base-content/80"><%= tidy k.lead %></p>
          </div>
          <p class="mt-auto text-sm font-semibold text-base-content/70"><%= tidy k.alter %></p>
        </a>
      </li>
    <% end %>
    <li class="sm:col-span-2 lg:col-span-4">
      <a href="/fuehrerschein/" class="tile tile-accent group flex h-full min-h-[12rem] flex-col justify-between gap-4 p-7 sm:p-9 lg:min-h-[13rem] lg:flex-row lg:items-center lg:gap-8 lg:p-12">
        <span class="text-sm font-bold uppercase tracking-[0.14em] opacity-80">Alle Details</span>
        <span class="h2" style="font-size:clamp(1.6rem,3.4vw,2.6rem)">Klassen, Voraussetzungen und Ablauf</span>
        <span class="inline-flex items-center gap-2 font-semibold">Zur Übersicht <%= icon :arrow, css: "size-5 transition group-hover:translate-x-1" %></span>
      </a>
    </li>
  </ul>
</section>
