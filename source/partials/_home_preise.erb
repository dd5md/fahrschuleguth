<section id="preise" class="mx-auto max-w-7xl px-4 py-8 sm:py-12 lg:py-16 xl:py-20" aria-labelledby="preise-title">
  <div class="max-w-3xl">
    <p class="eyebrow">Preise</p>
    <h2 id="preise-title" class="h2 mt-3">Transparent. Ohne <span class="text-gradient">Überraschungen</span>.</h2>
    <p class="mt-5 text-lg text-base-content/80">Preisliste gemäß Preisaushang Fahrlehrergesetz § 32.</p>
  </div>

  <%# Alle Klassen in derselben Reihenfolge wie auf der Seite „Führerscheinklassen“ (data/klassen.yml) %>
  <div data-tabs class="mt-6 sm:mt-10">
    <div role="tablist" aria-label="Führerscheinklasse" class="flex flex-wrap gap-2">
      <% data.klassen.each_with_index do |k, i| %>
        <button type="button" role="tab" id="tab-<%= k.id %>" aria-controls="panel-<%= k.id %>" aria-selected="<%= i.zero? %>" class="pill"><%= k.kurz == "B" ? "Klasse B" : k.kurz %></button>
      <% end %>
    </div>
    <% data.klassen.each do |k| %>
      <% liste = k.preis && data.preise.listen.find { |l| l.id == k.preis } %>
      <div role="tabpanel" id="panel-<%= k.id %>" aria-labelledby="tab-<%= k.id %>" class="tile mt-4 p-6 sm:p-9">
        <% if liste %>
          <div class="grid gap-8 lg:grid-cols-12">
            <div class="lg:col-span-4">
              <p class="eyebrow">Klasse <%= k.kurz %> · <%= k.titel %></p>
              <p class="mt-4 text-sm text-base-content/70">Grundbetrag, <%= liste.items.first.sub %></p>
              <p class="mt-2 text-6xl font-bold tracking-[-0.03em] text-primary"><%= liste.items.first.preis %></p>
              <% if k.preis_hinweis %><p class="mt-2 text-sm text-base-content/70"><%= k.preis_hinweis.sub(/\A./, &:upcase) %></p><% end %>
              <% if %w[a2 a].include?(k.id) %><p class="mt-2 text-sm text-base-content/70">Eine gemeinsame Preisliste für A2 und A.</p><% end %>
              <a href="/anmelden/?klasse=<%= k.kurz %>#formular" class="btn btn-primary mt-6 rounded-full">Anmelden <%= icon :arrow, css: "size-5" %></a>
            </div>
            <dl class="divide-y divide-base-content/10 lg:col-span-8">
              <% liste.items.drop(1).each do |item| %>
                <div class="flex items-baseline justify-between gap-4 py-3">
                  <dt><%= item.text %> <span class="text-sm text-base-content/65">(<%= item.sub %>)</span></dt>
                  <dd class="whitespace-nowrap font-semibold"><%= item.preis %></dd>
                </div>
              <% end %>
            </dl>
          </div>
        <% else %>
          <%# Platzhalter, bis Uli die Preise nennt %>
          <div class="grid gap-6 lg:grid-cols-12 lg:items-center">
            <div class="lg:col-span-4">
              <p class="eyebrow">Klasse <%= k.kurz %> · <%= k.titel %></p>
              <p class="mt-4 text-6xl font-bold tracking-[-0.03em] text-primary">???</p>
            </div>
            <div class="lg:col-span-8">
              <p class="text-lg text-base-content/80">Die Preise für diese Klasse nennt dir Uli gern persönlich: <a class="link link-primary whitespace-nowrap font-semibold" href="<%= tel_link data.site.contacts.first.tel %>"><%= phone data.site.contacts.first.phone %></a></p>
              <a href="/anmelden/?klasse=<%= k.kurz %>#formular" class="btn btn-primary mt-6 rounded-full">Anmelden <%= icon :arrow, css: "size-5" %></a>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
  <p class="mt-5 max-w-4xl text-sm text-base-content/70"><%= data.preise.hinweis %> <a class="link" href="/ueberuns/preise/">Alle Preise</a></p>
</section>
