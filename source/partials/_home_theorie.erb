<section id="theorie" class="mx-auto max-w-7xl px-4 py-8 sm:py-12 lg:py-16 xl:py-20" aria-labelledby="theorie-title">
  <div class="grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <p class="eyebrow"><%= data.theorie.eyebrow %></p>
      <h2 id="theorie-title" class="h2 mt-3">Theorie live im <span class="text-gradient">Klassenraum</span></h2>
      <p class="mt-5 text-lg text-base-content/85"><%= data.theorie.intro %></p>
      <a href="<%= data.theorie.link.href %>" class="link link-primary mt-6 inline-flex items-center gap-2 font-semibold"><%= data.theorie.link.label %> <%= icon :arrow, css: "size-4" %></a>
      <% sb = data.theorie.smartboard %>
      <figure class="tile mt-8 overflow-hidden">
        <%= picture_tag sb.bild, alt: sb.alt, sizes: "(min-width: 1024px) 40vw, 100vw", style: "aspect-ratio:4/3;object-fit:cover" %>
        <figcaption class="p-5">
          <p class="font-bold tracking-tight"><%= sb.titel %></p>
          <p class="mt-1 text-sm text-base-content/80"><%= sb.text %></p>
        </figcaption>
      </figure>
    </div>
    <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-7 lg:self-start">
      <% data.theorie.punkte.each_with_index do |pt, i| %>
        <li class="tile p-6">
          <span class="text-4xl font-bold leading-none tracking-[-0.03em] text-primary"><%= i + 1 %></span>
          <h3 class="h3-sm mt-4"><%= pt.titel %></h3>
          <p class="mt-2 text-base-content/80"><%= pt.text %></p>
        </li>
      <% end %>
    </ul>
  </div>
</section>
<div class="groove" aria-hidden="true"></div>
