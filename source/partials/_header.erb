<input type="checkbox" id="nav-toggle" class="peer sr-only" tabindex="-1" aria-hidden="true">
<header class="glass sticky top-0 z-40 border-b border-base-content/10">
  <nav class="mx-auto flex h-16 max-w-7xl items-center gap-0.5 px-1.5 min-[400px]:gap-1 min-[400px]:px-3 sm:gap-2 sm:px-4" aria-label="Hauptnavigation">
    <label for="nav-toggle" id="nav-burger" role="button" tabindex="0" aria-controls="nav-drawer" aria-expanded="false" aria-label="Menü öffnen"
           class="btn btn-ghost btn-circle size-10 min-[400px]:size-12 min-[1120px]:hidden"><%= icon :menu, css: "size-7" %></label>

    <a href="/" class="logo-wrap shrink-0 !px-1">
      <img src="<%= asset_path(:images, "logo.svg") %>" alt="Fahrschule Guth – total Guth" width="935" height="225" class="h-6 w-auto min-[400px]:h-8 sm:h-11" fetchpriority="low">
    </a>

    <ul class="ml-6 hidden items-center gap-1 text-[0.78rem] font-bold uppercase tracking-[0.1em] min-[1120px]:flex">
      <% data.site.nav.each do |item| %>
        <% active = item.href == "/" ? home? : current_page.url.start_with?(item.href) %>
        <li><a class="rounded-full px-3.5 py-2 transition hover:bg-base-content/10 <%= 'bg-base-content/10 text-primary' if active %>" href="<%= item.href %>" <%= 'aria-current="page"' if active %>><%= item.label %></a></li>
      <% end %>
    </ul>

    <div class="ml-auto flex items-center gap-1">
      <a href="<%= tel_link data.site.contacts.first.tel %>" class="btn btn-ghost btn-circle hidden sm:inline-flex" aria-label="Uli Guth anrufen: <%= data.site.contacts.first.phone %>"><%= icon :phone, css: "size-5" %></a>
      <a href="<%= whatsapp_link %>" target="_blank" rel="noopener noreferrer" class="btn btn-wa btn-sm rounded-full px-2.5 min-[400px]:btn-md min-[400px]:px-3 min-[1120px]:px-5" aria-label="Per WhatsApp schreiben">
        <%= social_icon :whatsapp, css: "size-5" %><span class="hidden text-[0.78rem] font-bold uppercase tracking-[0.08em] min-[1120px]:inline">WhatsApp</span>
      </a>      <a href="/anmelden/" class="btn btn-primary btn-sm rounded-full px-2 text-[0.64rem] tracking-[0.03em] min-[400px]:btn-md min-[400px]:px-3 min-[400px]:text-[0.72rem] min-[400px]:tracking-[0.06em] font-bold uppercase tracking-[0.06em] sm:px-5 sm:text-[0.78rem] sm:tracking-[0.08em]">Anmelden</a>
    </div>
  </nav>
</header>

<label for="nav-toggle" class="fixed inset-0 z-[60] bg-black/60 opacity-0 transition-opacity duration-200 pointer-events-none peer-checked:pointer-events-auto peer-checked:opacity-100 min-[1120px]:hidden" aria-hidden="true"></label>
<aside id="nav-drawer" aria-label="Menü"
       class="invisible fixed inset-y-0 left-0 z-[70] flex w-[min(22rem,90vw)] -translate-x-full flex-col overflow-y-auto bg-base-200 shadow-2xl transition-[transform,visibility] duration-200 peer-checked:visible peer-checked:translate-x-0 min-[1120px]:hidden">
  <div class="flex items-center justify-between gap-2 px-4 py-3">
    <a href="/" class="logo-wrap shrink-0"><img src="<%= asset_path(:images, "logo.svg") %>" alt="Fahrschule Guth, zur Startseite" width="935" height="225" class="h-9 w-auto" loading="lazy"></a>
    <label for="nav-toggle" role="button" tabindex="0" class="btn btn-ghost btn-circle size-12" aria-label="Menü schließen"><%= icon :close, css: "size-7" %></label>
  </div>
  <nav aria-label="Hauptmenü" class="px-2">
    <ul>
      <% data.site.nav.each do |item| %>
        <% active = item.href == "/" ? home? : current_page.url.start_with?(item.href) %>
        <li><a href="<%= item.href %>" <%= 'aria-current="page"' if active %> class="flex min-h-14 items-center rounded-2xl px-4 text-lg font-bold uppercase tracking-wider transition active:bg-base-content/10 <%= active ? 'bg-base-content/10 text-primary' : '' %>"><%= item.label %></a></li>
      <% end %>
    </ul>
  </nav>
  <nav aria-label="Weitere Seiten" class="mt-2 border-t border-base-content/10 px-2 pt-3">
    <ul>
      <% data.site.drawer_more.each do |item| %>
        <li>
          <% if item.primary %>
            <a href="<%= item.href %>" class="btn btn-primary mb-2 h-14 w-full rounded-full text-base font-bold uppercase tracking-wider"><%= item.label %></a>
          <% else %>
            <a href="<%= item.href %>" class="flex min-h-12 items-center rounded-2xl px-4 text-base text-base-content/85 transition active:bg-base-content/10"><%= item.label %></a>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>
  <div class="sticky bottom-0 mt-auto space-y-3 border-t border-base-content/10 bg-base-200 p-4">
    <a href="<%= whatsapp_link %>" target="_blank" rel="noopener noreferrer" class="btn btn-wa h-14 w-full gap-3 rounded-full text-base font-bold"><%= social_icon :whatsapp, css: "size-6" %> WhatsApp schreiben</a>
    <a href="<%= tel_link data.site.contacts.first.tel %>" class="btn btn-outline h-14 w-full gap-3 rounded-full border-base-content/25 text-base"><%= icon :phone, css: "size-5 text-primary" %> <%= phone data.site.contacts.first.phone %></a>
  </div>
</aside>
