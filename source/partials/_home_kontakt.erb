<section id="kontakt" class="mx-auto max-w-7xl px-4 py-8 sm:py-12 lg:py-16 xl:py-20" aria-labelledby="kontakt-title">
  <div class="tile tile-accent grid gap-10 p-8 sm:p-14 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="text-xs font-bold uppercase tracking-[0.14em] opacity-80">Wir sind für dich da</p>
      <h2 id="kontakt-title" class="display mt-4" style="font-size:clamp(2.6rem,7vw,6rem)">Fragen? Ruf einfach an<strong>.</strong></h2>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="<%= tel_link data.site.contacts.first.tel %>" class="btn btn-lg rounded-full bg-base-100 text-base-content hover:bg-base-200"><%= icon :phone, css: "size-5 text-primary" %> <%= phone(data.site.contacts.first.phone) %></a>
        <a href="<%= whatsapp_link %>" target="_blank" rel="noopener noreferrer" class="btn btn-lg rounded-full bg-[#25d366] text-[#052e13] hover:bg-[#3ee37f]"><%= social_icon :whatsapp, css: "size-5" %> WhatsApp</a>
        <a href="/anmelden/" class="btn btn-lg rounded-full bg-white text-[#17181c] hover:bg-white/80">Online anmelden</a>
      </div>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:col-span-5 lg:grid-cols-1">
      <div>
        <h3 class="text-sm font-bold uppercase tracking-[0.12em] opacity-80">Öffnungszeiten</h3>
        <ul class="mt-2 space-y-1">
          <% data.site.hours.each do |h| %>
            <li><strong><%= h.day %>:</strong> <%= h.times.map { |t| "<span class=\"whitespace-nowrap\">#{t}</span>" }.join(" &amp; ") %></li>
          <% end %>
          <li class="opacity-90"><%= phone(data.site.hours_phone, sep: "opacity-50") %></li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-bold uppercase tracking-[0.12em] opacity-80">Theorie-Unterricht</h3>
        <ul class="mt-2 space-y-1">
          <% data.site.theory.each do |t| %><li><strong><%= t.day %>:</strong> <%= t.time %></li><% end %>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-bold uppercase tracking-[0.12em] opacity-80">Büro &amp; Anmeldung</h3>
        <p class="mt-2">Bettina Guth: <a class="font-semibold underline" href="<%= tel_link data.site.contacts[1].tel %>"><%= phone(data.site.contacts[1].phone, sep: "opacity-50") %></a></p>
      </div>
    </div>
  </div>
</section>
