---
title: Preise
pagetitle: Preise
smalltitle: gemäß Preisaushang Fahrlehrergesetz § 32
description: 'Preisliste der Fahrschule Guth Bochum für Klasse B, A1, A2 und A gemäß Preisaushang: Grundbetrag 470,00 € inkl. Theorieunterricht, Übungsstunde je 45 Minuten.'
subnav: ueberuns
breadcrumb_parents:
  - { label: Über Uns, href: /ueberuns/ }
---
<%= partial "partials/page_header" %>
<section class="py-16">
  <div class="mx-auto max-w-7xl px-4">
    <div class="grid gap-6 lg:grid-cols-3">
      <% data.preise.listen.each_with_index do |liste, i| %>
        <article class="card bg-base-200 shadow-sm <%= 'ring-2 ring-primary' if i == 0 %>" aria-labelledby="<%= liste.id %>">
          <div class="card-body">
            <h2 id="<%= liste.id %>" class="card-title text-2xl">Preisliste <span class="text-primary">Klasse <%= liste.title.sub("Klasse ", "") %></span></h2>
            <p class="text-sm italic text-base-content/70">gemäß Preisaushang Fahrlehrergesetz § 32</p>
            <ul class="mt-3 divide-y divide-base-content/10">
              <% liste["items"].each do |p| %>
                <li class="flex items-center justify-between gap-4 py-3">
                  <div><p class="font-semibold"><%= p["text"] %></p><p class="text-sm text-base-content/70"><%= p["sub"] %></p></div>
                  <p class="whitespace-nowrap text-lg font-bold text-primary"><%= p["preis"] %></p>
                </li>
              <% end %>
            </ul>
          </div>
        </article>
      <% end %>
    </div>
    <p class="mx-auto mt-10 max-w-3xl text-center text-sm leading-relaxed text-base-content/70"><%= data.preise.hinweis %></p>
  </div>
</section>
