---
title: Preise
pagetitle: Preise
smalltitle: gemäß Preisaushang Fahrlehrergesetz § 32
description: 'Preisliste der Fahrschule Guth Bochum für Klasse B, A1, A2 und A gemäß Preisaushang: Grundbetrag 470,00 € inkl. Theorieunterricht, Übungsstunde je 45 Minuten.'
subnav: ueberuns
breadcrumb_parents:
  - { label: Über Uns, href: /ueberuns/ }
---
<%= partial "partials/page_header" %>
<section class="py-8 sm:py-16">
  <div class="mx-auto max-w-7xl px-4">
    <div class="grid gap-6 lg:grid-cols-3">
      <% data.preise.listen.each_with_index do |liste, i| %>
        <article class="tile <%= 'ring-2 ring-primary' if i == 0 %>" aria-labelledby="<%= liste.id %>">
          <div class="p-6 sm:p-8">
            <h2 id="<%= liste.id %>" class="text-2xl font-bold tracking-tight">Preisliste <span class="text-primary">Klasse <%= liste.title.sub("Klasse ", "") %></span></h2>
            <p class="text-sm italic text-base-content/80">gemäß Preisaushang Fahrlehrergesetz § 32</p>
            <ul class="mt-3 divide-y divide-base-content/10">
              <% liste["items"].each do |p| %>
                <li class="flex items-center justify-between gap-4 py-3">
                  <div><p class="font-semibold"><%= p["text"] %></p><p class="text-sm text-base-content/80"><%= p["sub"] %></p></div>
                  <p class="whitespace-nowrap text-lg font-bold text-primary"><%= p["preis"] %></p>
                </li>
              <% end %>
            </ul>
          </div>
        </article>
      <% end %>
    </div>

    <%# Weitere Klassen ohne eigene Preisliste: BF17 wie Klasse B, übrige mit Platzhalter ??? (Preise von Uli nachliefern) %>
    <h2 class="h3 mt-12">Weitere Klassen</h2>
    <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <% data.klassen.reject { |k| %w[b a1 a2 a].include?(k.id) }.each do |k| %>
        <li class="tile flex flex-col gap-3 p-6">
          <p class="text-4xl font-bold leading-none tracking-[-0.03em] text-primary"><%= k.kurz %></p>
          <p class="font-semibold"><%= tidy k.titel %></p>
          <% if k.preis %>
            <p class="text-base-content/80"><%= k.preis_hinweis.to_s.sub(/\A./, &:upcase) %>: <a class="link link-primary font-semibold" href="#<%= k.preis %>">Preisliste Klasse B</a></p>
          <% else %>
            <p class="text-3xl font-bold text-primary">???</p>
            <p class="text-sm text-base-content/80">Preise folgen. Bis dahin: <a class="link link-primary whitespace-nowrap font-semibold" href="<%= tel_link data.site.contacts.first.tel %>"><%= phone data.site.contacts.first.phone %></a></p>
          <% end %>
          <a href="/fuehrerschein/#<%= k.id %>" class="link mt-auto inline-flex items-center gap-2 pt-2 text-sm font-semibold">Zur Klasse <%= icon :arrow, css: "size-4" %></a>
        </li>
      <% end %>
    </ul>
    <p class="mx-auto mt-10 max-w-3xl text-center text-sm leading-relaxed text-base-content/80"><%= data.preise.hinweis %></p>
  </div>
</section>
