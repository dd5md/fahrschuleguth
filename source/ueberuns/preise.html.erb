---
title: Preise
pagetitle: Preise
smalltitle: gemäß Preisaushang Fahrlehrergesetz § 32
description: 'Preisliste der Fahrschule Guth Bochum für Klasse B, A1, A2 und A gemäß Preisaushang: Grundbetrag 470,00 € inkl. Theorieunterricht, Übungsstunde je 45 Minuten.'
subnav: ueberuns
breadcrumb_parents:
  - { label: Über Uns, href: /ueberuns/ }
---
<%= partial "partials/page_header" %>
<section class="py-8 sm:py-16">
  <div class="mx-auto max-w-7xl px-4">
    <% hauptlisten = data.preise.listen.reject { |l| l.gruppe == "zusatz" } %>
    <% zusatzlisten = data.preise.listen.select { |l| l.gruppe == "zusatz" } %>

    <div class="grid gap-6 lg:grid-cols-3">
      <% hauptlisten.each_with_index do |liste, i| %>
        <article id="<%= liste.id %>" class="tile scroll-mt-24 <%= 'ring-2 ring-primary' if i == 0 %>" aria-labelledby="<%= liste.id %>-titel">
          <div class="p-6 sm:p-8">
            <h2 id="<%= liste.id %>-titel" class="text-2xl font-bold tracking-tight">Preisliste <span class="text-primary">Klasse <%= liste.title.sub("Klasse ", "") %></span></h2>
            <p class="text-sm italic text-base-content/80"><%= liste.untertitel || (liste.platzhalter ? "Preise folgen in Kürze" : "gemäß Preisaushang Fahrlehrergesetz § 32") %></p>
            <ul class="mt-3 divide-y divide-base-content/10">
              <% liste["items"].each do |p| %>
                <li class="flex items-center justify-between gap-4 py-3">
                  <div><p class="font-semibold"><%= p["text"] %></p><p class="text-sm text-base-content/80"><%= p["sub"] %></p></div>
                  <p class="whitespace-nowrap text-lg font-bold text-primary"><%= p["preis"] %></p>
                </li>
              <% end %>
            </ul>
          </div>
        </article>
      <% end %>
      <%# Klassen ohne Preisliste (z. B. AM): eigene breite Karte unter den Preislisten %>
      <% data.klassen.select { |k| k.preis_text }.each do |k| %>
        <article id="klasse-<%= k.id %>" class="tile scroll-mt-24 lg:col-span-3" aria-labelledby="klasse-<%= k.id %>-titel">
          <div class="grid gap-6 p-6 sm:p-8 lg:grid-cols-[1fr_auto] lg:items-center">
            <div>
              <h2 id="klasse-<%= k.id %>-titel" class="text-2xl font-bold tracking-tight">Klasse <span class="text-primary"><%= k.kurz %></span></h2>
              <p class="text-sm italic text-base-content/80"><%= k.titel %></p>
              <p class="mt-4 text-2xl font-bold tracking-tight">Preis <span class="text-primary"><%= k.preis_text %></span></p>
              <p class="mt-2 text-base-content/80">Ruf einfach an oder schreib uns: <a class="link link-primary whitespace-nowrap font-semibold" href="<%= tel_link data.site.contacts.first.tel %>"><%= phone data.site.contacts.first.phone %></a></p>
            </div>
            <a href="/fuehrerschein/<%= k.id %>/" class="link inline-flex items-center gap-2 text-sm font-semibold">Zur Klasse <%= icon :arrow, css: "size-4" %></a>
          </div>
        </article>
      <% end %>
    </div>

    <% unless zusatzlisten.empty? %>
      <div class="groove my-12" aria-hidden="true"></div>
      <div class="max-w-3xl">
        <p class="eyebrow">Zusatzqualifikationen</p>
        <h2 class="h3 mt-3">Erweiterung zum Pkw-Führerschein (Klasse B)</h2>
        <p class="mt-3 text-base-content/80">B196 ist keine eigene Führerscheinklasse, sondern eine Schulung, die du zusätzlich zur Klasse B machst, ohne Prüfung: Damit darfst du mit dem Pkw-Führerschein 125er-Motorräder fahren.</p>
      </div>
      <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <% zusatzlisten.each do |liste| %>
          <article id="<%= liste.id %>" class="tile scroll-mt-24" aria-labelledby="<%= liste.id %>-titel">
            <div class="p-6 sm:p-8">
              <h3 id="<%= liste.id %>-titel" class="text-2xl font-bold tracking-tight">Preisliste <span class="text-primary"><%= liste.title %></span></h3>
              <p class="text-sm italic text-base-content/80"><%= liste.untertitel || (liste.platzhalter ? "Preise folgen in Kürze" : "gemäß Preisaushang Fahrlehrergesetz § 32") %></p>
              <ul class="mt-3 divide-y divide-base-content/10">
                <% liste["items"].each do |p| %>
                  <li class="flex items-center justify-between gap-4 py-3">
                    <div><p class="font-semibold"><%= p["text"] %></p><p class="text-sm text-base-content/80"><%= p["sub"] %></p></div>
                    <p class="whitespace-nowrap text-lg font-bold text-primary"><%= p["preis"] %></p>
                  </li>
                <% end %>
              </ul>
            </div>
          </article>
        <% end %>
      </div>
    <% end %>

    <p class="mx-auto mt-10 max-w-3xl text-center text-sm leading-relaxed text-base-content/80"><%= data.preise.hinweis %></p>
  </div>
</section>
