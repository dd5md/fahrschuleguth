<%# Vorlage für /fuehrerschein/<id>/ (per proxy in config.rb); Daten aus data/klassen.yml, Preise aus data/preise.yml %>
<% liste = klasse.preis && data.preise.listen.find { |l| l.id == klasse.preis } %>
<% idx = data.klassen.index { |x| x.id == klasse.id } %>
<%= partial "partials/page_header" %>

<section class="mx-auto max-w-7xl px-4 py-8 sm:py-12 lg:py-16" aria-label="Kurzüberblick">
  <ul class="grid gap-4 sm:grid-cols-3">
    <li class="tile p-6"><p class="eyebrow">Mindestalter</p><p class="mt-3 text-2xl font-bold tracking-tight"><%= tidy klasse.alter %></p></li>
    <li class="tile p-6"><p class="eyebrow">Prüfung</p><p class="mt-3 text-2xl font-bold tracking-tight"><%= klasse.pruefung %></p></li>
    <li class="tile p-6">
      <p class="eyebrow">Preis</p>
      <% if liste %>
        <p class="mt-3 text-2xl font-bold tracking-tight text-primary"><%= liste.items.first.preis %></p>
        <p class="mt-1 text-sm text-base-content/75"><%= liste.items.first.text %><%= " · #{klasse.preis_hinweis}" if klasse.preis_hinweis %></p>
      <% else %>
        <p class="mt-3 text-2xl font-bold tracking-tight text-primary"><%= klasse.preis_text || "auf Anfrage" %></p>
      <% end %>
    </li>
  </ul>
</section>

<section class="mx-auto grid max-w-7xl gap-10 px-4 pb-8 sm:pb-12 lg:grid-cols-12 lg:pb-16">
  <div class="space-y-10 lg:col-span-7">
    <div>
      <h2 class="h2" style="font-size:clamp(1.6rem,3.4vw,2.4rem)">Das darfst du mit Klasse <%= klasse.kurz %> fahren</h2>
      <p class="mt-4 text-lg text-base-content/85"><%= klasse.darf %></p>
    </div>
    <div>
      <h2 class="h2" style="font-size:clamp(1.6rem,3.4vw,2.4rem)">So läuft die Ausbildung ab</h2>
      <p class="mt-4 text-lg text-base-content/85"><%= klasse.ablauf %></p>
      <% if klasse.id != "b196" %>
        <p class="mt-4 text-base-content/80">Die Theorie machst du als <a class="link" href="/#theorie">Präsenzunterricht</a> bei uns im Klassenraum (montags und donnerstags, 19:00 bis 20:30 Uhr). Wie die erste Fahrstunde abläuft, steht unter <a class="link" href="/#erster-fahrtag">Dein erster Fahrtag</a>.</p>
      <% end %>
    </div>
    <div>
      <h2 class="h2" style="font-size:clamp(1.6rem,3.4vw,2.4rem)">Das brauchst du zur Anmeldung</h2>
      <ul class="mt-4 space-y-3 text-base-content/85">
        <% ["Einen gültigen Ausweis oder Reisepass", "Ein biometrisches Passfoto", (klasse.id == "b196" ? "Den Nachweis über Klasse B seit mindestens 5 Jahren (Führerschein)" : "Eine Sehtest-Bescheinigung"), (klasse.id == "b196" ? nil : "Die Bescheinigung über einen Erste-Hilfe-Kurs")].compact.each do |t| %>
          <li class="flex gap-3"><%= icon :check, css: "mt-1 size-5 shrink-0 text-primary", stroke: 2.5 %> <span><%= t %></span></li>
        <% end %>
      </ul>
      <p class="mt-3 text-sm text-base-content/70">Allgemeine Angaben, Stand 2026. Was bei dir genau nötig ist, klären wir gemeinsam bei der Anmeldung.</p>
    </div>
  </div>

  <aside class="space-y-4 lg:col-span-5">
    <div class="tile tile-accent p-7 sm:p-9">
      <p class="text-xs font-bold uppercase tracking-[0.14em] opacity-80">Los geht’s</p>
      <p class="h3 mt-3">Klasse <%= klasse.kurz %> bei Fahrschule Guth</p>
      <div class="mt-6 flex flex-col gap-3">
        <a href="/anmelden/?klasse=<%= klasse.kurz %>#formular" class="btn btn-lg rounded-full border-0 bg-base-100 text-base-content hover:bg-base-200">Jetzt anmelden <%= icon :arrow, css: "size-5" %></a>
        <a href="<%= whatsapp_link(data.site.contacts.first, "Hallo Uli, ich interessiere mich für Klasse #{klasse.kurz}.") %>" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-wa rounded-full"><%= social_icon :whatsapp, css: "size-5" %> WhatsApp</a>
        <a href="<%= tel_link data.site.contacts.first.tel %>" class="btn btn-lg btn-outline rounded-full border-primary-content/70 text-primary-content hover:border-primary-content hover:bg-primary-content hover:text-primary"><%= icon :phone, css: "size-5" %> <%= phone(data.site.contacts.first.phone) %></a>
      </div>
    </div>
    <% if liste && liste.items.size > 1 %>
      <div class="tile p-6">
        <h2 class="h3-sm">Preisliste im Überblick</h2>
        <dl class="mt-3 divide-y divide-base-content/10 text-sm">
          <% liste.items.each do |it| %>
            <div class="flex items-baseline justify-between gap-3 py-2"><dt><%= it.text %></dt><dd class="whitespace-nowrap font-semibold"><%= it.preis %></dd></div>
          <% end %>
        </dl>
        <a class="link mt-3 inline-flex items-center gap-2 text-sm font-semibold" href="/ueberuns/preise/">Alle Preise <%= icon :arrow, css: "size-4" %></a>
      </div>
    <% end %>
  </aside>
</section>

<div class="groove" aria-hidden="true"></div>
<section class="mx-auto max-w-7xl px-4 py-8 sm:py-12 lg:py-16" aria-labelledby="weitere-klassen">
  <h2 id="weitere-klassen" class="h3">Weitere Führerscheinklassen</h2>
  <ul class="mt-5 flex flex-wrap gap-2">
    <% data.klassen.each do |x| %>
      <li><a class="pill" href="/fuehrerschein/<%= x.id %>/" <%= 'aria-current="page"' if x.id == klasse.id %>><%= x.kurz %></a></li>
    <% end %>
    <li><a class="pill" href="/fuehrerschein/">Alle im Überblick</a></li>
  </ul>
</section>
