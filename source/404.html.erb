<section class="hero-glow relative overflow-hidden" aria-labelledby="fehler-titel">
  <div class="mx-auto flex min-h-[70vh] max-w-3xl flex-col items-center justify-center px-4 py-16 text-center sm:py-24">
    <p class="eyebrow">Fehler</p>
    <p class="text-gradient mt-2 select-none text-[clamp(7rem,32vw,17rem)] font-extrabold leading-[0.9] tracking-[-0.05em]" aria-hidden="true">404</p>
    <h1 id="fehler-titel" class="h2 mt-4">Seite nicht gefunden</h1>
    <p class="mt-4 max-w-md text-lg text-base-content/80">Die Seite gibt es nicht (mehr). Vielleicht hat sich die Adresse geändert, oder ein Link war nicht ganz richtig.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-primary btn-lg rounded-full px-7">Zur Startseite <%= icon :arrow, css: "size-5" %></a>
      <a href="/kontakt/" class="btn btn-lg rounded-full px-7">Kontakt</a>
    </div>
  </div>
</section>
