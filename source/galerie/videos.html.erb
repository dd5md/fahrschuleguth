---
title: Videos
pagetitle: Videos
description: 'Videos der Fahrschule Guth Bochum: Fahrschule, Fahrlehrer und Fahrschüler im Film.'
subnav: galerie
breadcrumb_parents:
  - { label: Galerie, href: /galerie/ }
---
<%= partial "partials/page_header" %>
<section class="mx-auto grid max-w-7xl gap-6 px-4 pb-16 pt-6 sm:grid-cols-2 lg:grid-cols-3">
  <% data.links.videos.each do |v| %>
    <div class="aspect-video overflow-hidden rounded-box bg-base-200 shadow-sm">
      <iframe class="size-full" src="https://www.youtube-nocookie.com/embed/<%= v.id %>?rel=0" title="<%= v.title %> der Fahrschule Guth" loading="lazy" allow="encrypted-media; picture-in-picture" allowfullscreen></iframe>
    </div>
  <% end %>
</section>
