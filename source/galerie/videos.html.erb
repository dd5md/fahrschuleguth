---
title: Videos
pagetitle: Videos
description: 'Videos der Fahrschule Guth Bochum: Fahrschule, Fahrlehrer und Fahrschüler im Film.'
subnav: galerie
breadcrumb_parents:
  - { label: Galerie, href: /galerie/ }
---
<%= partial "partials/page_header" %>
<section class="mx-auto grid max-w-7xl gap-6 px-4 pb-16 pt-6 sm:grid-cols-2 lg:grid-cols-3">
  <% data.links.videos.each do |v| %>
    <div class="tile aspect-video" data-embed="https://www.youtube-nocookie.com/embed/<%= v.id %>?rel=0&amp;autoplay=1" data-title="<%= v.title %> der Fahrschule Guth">
      <button type="button" class="flex size-full flex-col items-center justify-center gap-3 p-6 text-center transition hover:bg-base-content/5">
        <span class="grid size-16 place-items-center rounded-full bg-primary text-primary-content"><svg class="size-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span>
        <span class="font-semibold"><%= v.title %> abspielen</span>
        <span class="text-xs text-base-content/60">Beim Klick wird eine Verbindung zu YouTube hergestellt.</span>
      </button>
    </div>
  <% end %>
</section>
